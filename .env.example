# Copy to .env for local development: cp .env.example .env
# Everything prefixed with VITE_ is shipped to the browser. Never put a secret here.

# API base URL. A path ("/api") or an absolute URL ("http://localhost:3000" for the NestJS backend).
VITE_API_URL=/api

# "true" starts the MSW mock API in the browser before the app renders. "false" talks to VITE_API_URL.
VITE_USE_MOCK=true
